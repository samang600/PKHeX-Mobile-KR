<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net10.0-android36.0</TargetFrameworks>
		<!-- iOS는 macOS(Xcode)에서만 빌드 가능 → 맥(GitHub Actions 등)에서만 iOS 대상 추가 -->
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-android36.0;net10.0-ios</TargetFrameworks>
		<!-- GitHub Actions 맥 서버(또는 -p:IosOnly=true)에서는 iOS만 빌드. IosTfm으로 iOS 버전을 명시(예: net10.0-ios26.5) -->
		<IosTfm Condition="'$(IosTfm)' == ''">net10.0-ios</IosTfm>
		<TargetFrameworks Condition="'$(IosOnly)' == 'true' Or ('$(GITHUB_ACTIONS)' == 'true' And $([MSBuild]::IsOSPlatform('osx')))">$(IosTfm)</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>PKHeXKR</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ApplicationTitle>PKHeX 모바일</ApplicationTitle>
		<ApplicationId>com.pkhexkr.mobile</ApplicationId>
		<!-- 별도 설치판(구버전과 동시 설치): dotnet build ... -p:SideBySide=true → 패키지명·앱 이름만 다르게 -->
		<ApplicationId Condition="'$(SideBySide)' == 'true'">com.pkhexkr.mobile.side</ApplicationId>
		<ApplicationTitle Condition="'$(SideBySide)' == 'true'">PKHeX 모바일 (별도)</ApplicationTitle>
		<!-- 안드로이드 런처 이름은 기기 언어를 따라 (Platforms/Android/Resources/values*/strings.xml) -->
		<ApplicationTitle Condition="$(TargetFramework.Contains('-android')) And '$(SideBySide)' != 'true'">@string/app_name</ApplicationTitle>
		<ApplicationTitle Condition="$(TargetFramework.Contains('-android')) And '$(SideBySide)' == 'true'">@string/app_name_side</ApplicationTitle>
		<ApplicationDisplayVersion>1.7.9</ApplicationDisplayVersion>
		<ApplicationVersion>91</ApplicationVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<NoWarn>$(NoWarn);CS1998;CS8632;XC0022;XC0025;MAUIG2045;CA1416</NoWarn>
	</PropertyGroup>
	<!-- iOS: 리플렉션을 쓰는 코드(PKHeX·ALM·앱)가 잘리지 않도록 SDK만 축소, 동적 코드는 인터프리터로 -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<MtouchLink>SdkOnly</MtouchLink>
		<MtouchInterpreter>-all</MtouchInterpreter>
		<!-- 빌드 서버의 Xcode가 .NET iOS 요구 버전보다 낮아도 빌드 (새 iOS API를 쓰지 않음) -->
		<ValidateXcodeVersion>false</ValidateXcodeVersion>
		<CodesignKey></CodesignKey>
		<IosPokeLdnGenerated>$(MSBuildThisFileDirectory)Platforms/iOS/PokeLDN/Generated</IosPokeLdnGenerated>
	</PropertyGroup>
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And '$(WithPokeLdnIos)' != 'false' And Exists('$(MSBuildThisFileDirectory)Platforms/iOS/PokeLDN/Generated/Frameworks/PokeLdnRuntime.framework') And Exists('$(MSBuildThisFileDirectory)Platforms/iOS/PokeLDN/Generated/Frameworks/Python.xcframework')">
		<DefineConstants>$(DefineConstants);WITH_POKELDN_IOS</DefineConstants>
	</PropertyGroup>
	<!-- 1.4.7에서 Shared/PKHeXKR.Gen으로 옮긴 파일: 저장소에 예전 파일이 남아 있어도 빌드되게 제외 -->
	<ItemGroup>
		<Compile Remove="Quick\QuickParse.cs" />
	</ItemGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\icon.png" ForegroundFile="Resources\AppIcon\iconfg.png" Color="#FFFFFF" />
		<MauiSplashScreen Include="Resources\AppIcon\iconfg.png" BaseSize="200,200" Color="#FFFFFF" />
		<MauiImage Include="Resources\Images\NonShinySprites\*" />
		<MauiImage Include="Resources\Images\ShinySprites\*" />
		<MauiImage Include="Resources\Images\SVSprites\*" />
		<MauiImage Include="Resources\Images\balls\*" />
		<MauiImage Include="Resources\Images\ItemSprites\*" />
		<MauiImage Include="Resources\Images\square\*" />
		<MauiImage Include="Resources\Images\icons\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<!-- SV 레이드 보상 표 (PokeLDN raid_base.json을 줄임, Tera-Finder·GPL-3.0) -->
		<EmbeddedResource Include="raid9.json" LogicalName="raid9.json" />
		<MauiImage Include="Resources\Images\Ribbons\*" />
	</ItemGroup>
	<!-- PokeLDN 교환 (ESP32 보드 로컬 통신 교환): LDN 교환 앱(ldnapp/embed)을 라이브러리(AAR)로 넣음.
	     PokeLDN 파이썬 코드를 Chaquopy로 실행. 빼고 빌드: -p:WithLdn=false -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(WithLdn)' != 'false' And Exists('Platforms\Android\ldn\pokeldn-trade-kr.aar')">
		<DefineConstants>$(DefineConstants);WITH_LDN</DefineConstants>
		<!-- Chaquopy 파이썬 묶음(.imy)은 압축 없이 (Chaquopy 앱 빌드와 같게) -->
		<AndroidStoreUncompressedFileExtensions>$(AndroidStoreUncompressedFileExtensions);.imy</AndroidStoreUncompressedFileExtensions>
	</PropertyGroup>
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And '$(WithLdn)' != 'false' And Exists('Platforms\Android\ldn\pokeldn-trade-kr.aar')">
		<AndroidLibrary Include="Platforms\Android\ldn\pokeldn-trade-kr.aar" Bind="false" />
	</ItemGroup>
	<!-- Build Platforms/iOS/PokeLDN/build_ios_runtime.py before an iOS PokeLDN build. The generated
	     native frameworks carry CPython, its iOS extensions, CoreBluetooth, and the Python bridge. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And '$(WithPokeLdnIos)' != 'false' And Exists('$(IosPokeLdnGenerated)/Frameworks/PokeLdnRuntime.framework')">
		<NativeReference Include="$(IosPokeLdnGenerated)/Frameworks/Python.xcframework">
			<Kind>Framework</Kind>
		</NativeReference>
		<NativeReference Include="$(IosPokeLdnGenerated)/Frameworks/PokeLdnRuntime.framework">
			<Kind>Framework</Kind>
		</NativeReference>
		<!-- MSBuild wildcards match files, not framework bundle directories. Use the marker file
		     inside each generated extension framework to resolve its parent bundle path. -->
		<_PokeLdnExtensionFramework Include="$(IosPokeLdnGenerated)/Frameworks/**/*.origin" />
		<NativeReference Include="@(_PokeLdnExtensionFramework->'%(RootDir)%(Directory)')">
			<Kind>Framework</Kind>
		</NativeReference>
		<MauiAsset Include="$(IosPokeLdnGenerated)/Resources/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" Condition="'$(SkipPokeLdnAssetRebundle)' != 'true'" />
		<EmbeddedResource Include="Platforms/iOS/PokeLDN/Assets/gifts/*.json" LogicalName="PKHeXKR.PokeLDN.%(Filename)%(Extension)" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="FluentFTP" Version="52.1.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.0" />
		</ItemGroup>
	<!-- PKHeX.Core: 기본은 개발 버전 소스(PKHeX-Core-Dev). PC 플러그인처럼 PKHeX 본체 버전에 맞춰야 할 때는 UsePkhexNuget=true → 정식 패키지 -->
	<ItemGroup Condition="'$(UsePkhexNuget)' != 'true'">
		<ProjectReference Include="..\PKHeX-Core-Dev\PKHeX.Core\PKHeX.Core.csproj" GlobalPropertiesToRemove="RuntimeIdentifiers;RuntimeIdentifier;IosOnly;IosTfm" />
	</ItemGroup>
	<ItemGroup Condition="'$(UsePkhexNuget)' == 'true'">
		<PackageReference Include="PKHeX.Core" Version="26.10.18" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\Shared\PKHeXKR.Gen\PKHeXKR.Gen.csproj" GlobalPropertiesToRemove="RuntimeIdentifiers;RuntimeIdentifier;IosOnly;IosTfm" />
		<ProjectReference Include="..\PKHeX-Plugins\PKHeX.Core.AutoMod\PKHeX.Core.AutoMod.csproj" GlobalPropertiesToRemove="RuntimeIdentifiers;RuntimeIdentifier;IosOnly;IosTfm" />
		<ProjectReference Include="..\PKHeX-Plugins\PKHeX.Core.Injection\PKHeX.Core.Injection.csproj" GlobalPropertiesToRemove="RuntimeIdentifiers;RuntimeIdentifier;IosOnly;IosTfm" />
		<ProjectReference Include="..\HOMELive\HomeLive.Core\HomeLive.Core.csproj" GlobalPropertiesToRemove="RuntimeIdentifiers;RuntimeIdentifier;IosOnly;IosTfm" />
		<ProjectReference Include="..\HOMELive\HomeLive.DeviceExecutor\HomeLive.DeviceExecutor.csproj" GlobalPropertiesToRemove="RuntimeIdentifiers;RuntimeIdentifier;IosOnly;IosTfm" />
		<Reference Include="SysBot.Base"><HintPath>..\HOMELive\HomeLive.DeviceExecutor\deps\SysBot.Base.dll</HintPath></Reference>
	</ItemGroup>
</Project>
